---
import Layout from "../../../../../layouts/Layout.astro";
import AdminAccess from "../../../../../components/AdminAccess.astro";
import { configured } from "../../../../../server/db.js";
import { isAdmin } from "../../../../../server/auth.js";
import { questionnaireRecipients } from "../../../../../server/coverage.js";
import { editorPage } from "../../../../../server/regions.js";
import QuestionnaireInvitations from "../../../../../components/QuestionnaireInvitations.astro";

const ready = configured();
const authenticated = ready && isAdmin(Astro.cookies);
let page = null;
let recipients = [];
let loadError = false;
if (authenticated) {
  try { page = await editorPage(Astro.params.slug, Astro.params.id); if (page) recipients = await questionnaireRecipients(Astro.params.slug, Astro.params.id); }
  catch { loadError = true; }
}
if (authenticated && !loadError && !page) return new Response("Questionnaire not found", { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
const error = Astro.url.searchParams.get("error");
const region = page?.region;
const questionnaire = page?.questionnaire;
---

<Layout title="Manage questionnaire">
  <AdminAccess ready={ready} authenticated={authenticated}>
    {loadError ? (
      <p class="notice error" role="alert">This questionnaire could not be loaded.</p>
    ) : questionnaire && (
      <>
        <p><a href={questionnaire.risk_id ? `/admin/regions/${region.slug}?risk=${encodeURIComponent(questionnaire.risk_id)}` : `/admin/regions/${region.slug}`}>Back to {region.name}</a></p>
        {questionnaire.risk_id ? <p class="notice"><strong>{questionnaire.risk_id}</strong> · {questionnaire.risk_title}</p> : <p class="notice">This existing questionnaire has no risk yet. Link it from the country page.</p>}
        <h1>Manage questionnaire</h1>
        <p class="intro">{questionnaire.topic}</p>
        <nav class="questionnaire-management-nav" aria-label="Questionnaire management">
          {!questionnaire.sent && <a href="#questions">Questions</a>}
          <a href="#invitations">Invitations</a>
          {questionnaire.sent && <a href="#questions">Questions</a>}
          <a href={`/admin/results/${questionnaire.id}`}>Results and rounds</a>
        </nav>
        <p class="muted">Opened {questionnaire.opened} · {region.name}</p>
        {questionnaire.sent && <p class="notice" role="status">First invitations created on {questionnaire.sent}. Questions are locked; additional recipients and return links can be selected below.</p>}
        {error === "options" && <p class="notice error" role="alert">Multiple choice needs at least two options, one per line.</p>}
        {error === "question" && <p class="notice error" role="alert">Check the question and try again.</p>}
        {error === "locked" && <p class="notice error" role="alert">This questionnaire has already been sent.</p>}
        {Astro.url.searchParams.get('manual') === '1' && !questionnaire.sent && !questionnaire.questions.length && <p class="notice" role="status">Automatic question drafting is unavailable. Add your questions below.</p>}

        {questionnaire.sent && <QuestionnaireInvitations region={region} questionnaire={questionnaire} recipients={recipients} />}

        <h2 id="questions">Questions</h2>
        {!questionnaire.questions.length && <p>No questions yet.</p>}
        {questionnaire.questions.map((question, index) => (
          <article class="card">
            <h3>Question {index + 1}</h3>
            {questionnaire.sent ? (
              <>
                <p>{question.prompt}</p>
                <p class="muted">{question.type === "single" ? "Multiple choice" : "Free text"}</p>
                {question.type === "single" && <ul>{(question.options || []).map((option) => <li>{option}</li>)}</ul>}
                {question.type === "text" && <p>{question.placeholder || "Free text."}</p>}
              </>
            ) : (
              <>
                <form method="post" action="/api/admin/questionnaire-editor">
                  <input type="hidden" name="region" value={region.slug} />
                  <input type="hidden" name="questionnaire" value={questionnaire.id} />
                  <input type="hidden" name="question" value={question.id} />
                  <input type="hidden" name="action" value="update" />
                  <label for={`prompt-${question.id}`}>Question</label>
                  <input id={`prompt-${question.id}`} name="prompt" value={question.prompt} required maxlength="300" />
                  <label for={`type-${question.id}`}>Type</label>
                  <select id={`type-${question.id}`} name="type" required>
                    <option value="single" selected={question.type === "single"}>Multiple choice</option>
                    <option value="text" selected={question.type === "text"}>Free text</option>
                  </select>
                  <label for={`options-${question.id}`}>Answers, one per line</label>
                  <textarea id={`options-${question.id}`} name="options" maxlength="2000">{(question.options || []).join("\n")}</textarea>
                  <label for={`placeholder-${question.id}`}>Free text hint</label>
                  <input id={`placeholder-${question.id}`} name="placeholder" value={question.placeholder || ""} maxlength="180" />
                  <div class="actions"><button type="submit">Save question</button></div>
                </form>
                <form method="post" action="/api/admin/questionnaire-editor">
                  <input type="hidden" name="region" value={region.slug} />
                  <input type="hidden" name="questionnaire" value={questionnaire.id} />
                  <input type="hidden" name="question" value={question.id} />
                  <input type="hidden" name="action" value="remove" />
                  <button class="secondary" type="submit">Remove</button>
                </form>
              </>
            )}
          </article>
        ))}

        {!questionnaire.sent && (
          <form class="card" method="post" action="/api/admin/questionnaire-editor">
            <h2>Add a question</h2>
            <input type="hidden" name="region" value={region.slug} />
            <input type="hidden" name="questionnaire" value={questionnaire.id} />
            <input type="hidden" name="action" value="add" />
            <label for="prompt">Question</label>
            <input id="prompt" name="prompt" required maxlength="300" />
            <label for="type">Type</label>
            <select id="type" name="type" required>
              <option value="single">Multiple choice</option>
              <option value="text">Free text</option>
            </select>
            <label for="options">Multiple choice options, one per line</label>
            <textarea id="options" name="options" maxlength="2000"></textarea>
            <label for="placeholder">Free text hint</label>
            <input id="placeholder" name="placeholder" maxlength="180" />
            <div class="actions"><button type="submit">Add question</button></div>
          </form>
        )}

        {!questionnaire.sent && <QuestionnaireInvitations region={region} questionnaire={questionnaire} recipients={recipients} />}
      </>
    )}
  </AdminAccess>
</Layout>

<style>
  .questionnaire-management-nav {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1.25rem;
    margin: 1rem 0;
    padding: .75rem 0;
    border-top: 1px solid #d4ddd1;
    border-bottom: 1px solid #d4ddd1;
  }
  .questionnaire-management-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 650;
  }
  #questions, #invitations { scroll-margin-top: 1rem; }
</style>
