---
const { ready, authenticated } = Astro.props;
---

{!ready ? (
  <div class="notice">Set DATABASE_URL, ADMIN_PASSWORD and SESSION_SECRET, then apply db/schema.sql, before countries and questionnaires can be stored.</div>
) : !authenticated ? (
  <form class="card" method="post" action="/api/admin/login">
    <h2>Admin sign in</h2>
    {Astro.url.searchParams.get("error") === "login" && <p class="notice error" role="alert">Sign in failed. Check your password and try again.</p>}
    <label for="password">Admin password</label>
    <input id="password" name="password" type="password" required autocomplete="current-password" maxlength="256" />
    <div class="actions"><button>Sign in</button></div>
    <p class="muted">Use the ADMIN_PASSWORD configured for this deployment.</p>
  </form>
) : <slot />}
