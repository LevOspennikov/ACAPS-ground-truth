DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate each secret separately with: openssl rand -hex 32
ADMIN_PASSWORD=
SESSION_SECRET=
# Prototype only: enable in Vercel Production to erase app data after each build.
# Local and Preview builds never reset the database.
RESET_DATABASE_ON_DEPLOY=false
# Server-only. Used when an admin generates a questionnaire from a risk.
GREEN_PT_API_KEY=
