DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate each secret separately with: openssl rand -hex 32
ADMIN_PASSWORD=
SESSION_SECRET=
# Server-only: minimum submitted answers per question before experts see results.
# Nonnegative integer. Zero shows available distributions immediately.
EXPERT_RESULTS_MIN_RESPONSES=0
# Prototype only: enable in Vercel Production to erase app data after each build.
# Local and Preview builds never reset the database.
RESET_DATABASE_ON_DEPLOY=false
# Server-only. Used when an admin generates a questionnaire from a risk.
GREEN_PT_API_KEY=
# Optional invitation emails for named profiles. Manual links remain available.
RESEND_API_KEY=
EMAIL_FROM=
