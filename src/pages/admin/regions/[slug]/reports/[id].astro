---
import Layout from "../../../../../layouts/Layout.astro";
import AdminAccess from "../../../../../components/AdminAccess.astro";
import { configured } from "../../../../../server/db.js";
import { isAdmin } from "../../../../../server/auth.js";
import { reportPage } from "../../../../../server/regions.js";

const ready = configured();
const authenticated = ready && isAdmin(Astro.cookies);
let report = null;
let loadError = false;
if (authenticated) {
  try { report = await reportPage(Astro.params.slug, Astro.params.id); }
  catch { loadError = true; }
}
if (authenticated && !loadError && !report) return new Response("Report not found", { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
---

<Layout title={report?.title || "Report"}>
  <AdminAccess ready={ready} authenticated={authenticated}>
    {loadError ? <p class="notice error" role="alert">This report could not be loaded.</p> : report && (
      <>
        <p><a href={`/admin/regions/${report.region.slug}?view=reports`}>Back to {report.region.name} reports</a></p>
        <h1>{report.title}</h1>
        <p class="muted">{report.date} · {report.region.name}</p>
        <article class="card"><p>{report.summary}</p></article>
      </>
    )}
  </AdminAccess>
</Layout>
