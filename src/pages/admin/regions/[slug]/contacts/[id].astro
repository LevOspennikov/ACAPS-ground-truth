---
import Layout from "../../../../../layouts/Layout.astro";
import AdminAccess from "../../../../../components/AdminAccess.astro";
import Participation from "../../../../../components/Participation.astro";
import { configured } from "../../../../../server/db.js";
import { isAdmin } from "../../../../../server/auth.js";
import { contactPage } from "../../../../../server/regions.js";

const ready = configured();
const authenticated = ready && isAdmin(Astro.cookies);
let contact = null;
let loadError = false;
if (authenticated) {
  try { contact = await contactPage(Astro.params.slug, Astro.params.id); }
  catch { loadError = true; }
}
if (authenticated && !loadError && !contact) return new Response("Contact not found", { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
---

<Layout title={contact?.name || "Contact"}>
  <AdminAccess ready={ready} authenticated={authenticated}>
    {loadError ? <p class="notice error" role="alert">This contact could not be loaded.</p> : contact && (
      <>
        <p><a href={`/admin/regions/${contact.region.slug}`}>Back to {contact.region.name}</a></p>
        <h1>{contact.name}</h1>
        <p><Participation joined={contact.joined} invited={contact.invited} /></p>
        <p class="muted">{contact.focus ? `${contact.focus} · ` : ""}{contact.region.name}</p>
        <h2>Past answers</h2>
        {!contact.answers.length && <p>No past answers.</p>}
        {contact.answers.map((item) => (
          <article class="card">
            <h3>{item.topic}</h3>
            <p class="muted">{item.date}</p>
            <p>{item.submitted ? "Response submitted." : "Not yet submitted."}</p>
          </article>
        ))}
      </>
    )}
  </AdminAccess>
</Layout>
