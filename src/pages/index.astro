---
import questions from "../data/questions.js";

const total = questions.length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3f0e8" />
    <title>Expert review</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <style is:inline>
      :root {
        color-scheme: light;
        --bg: #f3f0e8;
        --card: #fffefb;
        --ink: #1c1915;
        --muted: #4a453e;
        --line: #c9c2b4;
        --accent: #0e3a5d;
        --accent-ink: #ffffff;
        --selected: #e5f0f7;
        --error: #6d1212;
        font-family: system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100dvh;
        background: var(--bg);
        color: var(--ink);
      }
      .shell {
        width: min(100%, 32rem);
        margin: 0 auto;
        padding:
          max(0.75rem, env(safe-area-inset-top))
          max(0.75rem, env(safe-area-inset-right))
          max(0.75rem, env(safe-area-inset-bottom))
          max(0.75rem, env(safe-area-inset-left));
      }
      .eyebrow {
        margin: 0 0 0.75rem;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--accent);
      }
      .card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 1rem;
      }
      .slides { display: grid; }
      .slide {
        grid-area: 1 / 1;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        padding: 1rem;
      }
      .js .slide { visibility: hidden; }
      .js .slide.is-active { visibility: visible; }
      html:not(.js) .slide { visibility: hidden; }
      html:not(.js) .slide:first-child,
      html:not(.js) .slide:target { visibility: visible; }
      html:not(.js) .slides:has(.slide:target) .slide:not(:target) { visibility: hidden; }
      .progress { margin: 0; font-size: 0.875rem; font-weight: 700; }
      h1 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.25;
      }
      fieldset {
        margin: 0;
        padding: 0;
        border: 0;
        display: grid;
        gap: 0.5rem;
      }
      legend {
        margin: 0 0 0.5rem;
        font-size: 1rem;
        font-weight: 700;
      }
      .option {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.75rem;
        align-items: center;
        min-height: 3rem;
        padding: 0.8rem 0.9rem;
        border: 2px solid var(--line);
        border-radius: 0.75rem;
        background: #fff;
        font-size: 1.0625rem;
        line-height: 1.3;
        cursor: pointer;
      }
      .option:has(input:checked) {
        border-color: var(--accent);
        background: var(--selected);
      }
      .option:has(input:focus-visible),
      textarea:focus-visible,
      .button:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
      }
      .option input {
        width: 1.25rem;
        height: 1.25rem;
        margin: 0;
        accent-color: var(--accent);
      }
      textarea {
        width: 100%;
        min-height: 8rem;
        padding: 0.85rem 0.9rem;
        border: 2px solid var(--line);
        border-radius: 0.75rem;
        background: #fff;
        color: var(--ink);
        font: 1rem/1.45 system-ui, sans-serif;
        resize: vertical;
      }
      textarea::placeholder { color: #5c564c; }
      .error, .status {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 700;
      }
      .error { color: var(--error); }
      .status { color: var(--ink); }
      .actions {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 3.25rem;
        padding: 0.75rem 1rem;
        border: 0;
        border-radius: 999px;
        font: 700 1.0625rem/1 system-ui, sans-serif;
        text-decoration: none;
        cursor: pointer;
        touch-action: manipulation;
      }
      .button.primary { background: var(--accent); color: var(--accent-ink); }
      .button.ghost { background: transparent; color: var(--accent); }
      .button:disabled { cursor: default; }
      @media (min-width: 40rem) {
        .shell { padding-top: 2rem; }
        h1 { font-size: 1.75rem; }
        .actions { flex-direction: row; }
        .button { width: auto; min-width: 7.5rem; }
        .button.primary { margin-left: auto; }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <p class="eyebrow">Expert review</p>
      <form id="wizard" class="card">
        <div class="slides">
          {
            questions.map((question, index) => (
              <section class="slide" id={`q-${index}`} aria-labelledby={`prompt-${question.id}`}>
                <p class="progress">Question {index + 1} of {total}</p>
                <h1 id={`prompt-${question.id}`}>{question.prompt}</h1>
                {question.type === "single" ? (
                  <fieldset aria-labelledby={`prompt-${question.id}`}>
                    {question.options.map((option, optionIndex) => (
                      <label class="option">
                        <input type="radio" name={question.id} value={`${question.id}-${optionIndex}`} />
                        <span>{option}</span>
                      </label>
                    ))}
                  </fieldset>
                ) : (
                  <textarea
                    name={question.id}
                    rows="4"
                    placeholder={question.placeholder}
                    aria-labelledby={`prompt-${question.id}`}
                  />
                )}
                <div class="actions">
                  {index > 0 && (
                    <a class="button ghost" href={`#q-${index - 1}`}>Back</a>
                  )}
                  <a class="button primary" href={index === total - 1 ? "#thanks" : `#q-${index + 1}`} data-next>
                    {index === total - 1 ? "Finish" : "Next"}
                  </a>
                </div>
              </section>
            ))
          }
          <section class="slide thanks" id="thanks" aria-labelledby="thanks-title">
            <h1 id="thanks-title">Thank you for participating</h1>
            <fieldset>
              <legend>Submit as</legend>
              <label class="option">
                <input type="radio" name="visibility" value="anonymous" />
                <span>Anonymous</span>
              </label>
              <label class="option">
                <input type="radio" name="visibility" value="public" />
                <span>Public</span>
              </label>
              <label class="option">
                <input type="radio" name="visibility" value="secret" />
                <span>Secret</span>
              </label>
            </fieldset>
            <p class="error" id="submit-error" hidden>Choose anonymous, public, or secret.</p>
            <p class="status" id="submit-status" hidden></p>
            <div class="actions">
              <button class="button primary" id="submit" type="button">Submit</button>
            </div>
          </section>
        </div>
      </form>
    </main>
    <script is:inline>
      const form = document.querySelector("#wizard");
      if (form) {
        const slides = [...form.querySelectorAll(".slide")];
        const activeSlide = () => {
          const id = location.hash.replace("#", "");
          return slides.find((slide) => slide.id === id) || slides[0];
        };
        const sync = () => {
          const current = activeSlide();
          slides.forEach((slide) => {
            const active = slide === current;
            slide.classList.toggle("is-active", active);
            slide.toggleAttribute("inert", !active);
            slide.setAttribute("aria-hidden", active ? "false" : "true");
          });
        };
        form.querySelectorAll("[data-next]").forEach((control) => {
          control.addEventListener("click", (event) => {
            const slide = control.closest(".slide");
            const text = slide.querySelector("textarea");
            const choices = [...slide.querySelectorAll('input[type="radio"]')];
            const answered = text
              ? text.value.trim().length > 0
              : choices.some((choice) => choice.checked);
            const existing = slide.querySelector(".error");
            if (answered) {
              existing?.remove();
              return;
            }
            event.preventDefault();
            const message = text ? "Write an answer to continue." : "Choose an answer to continue.";
            if (existing) existing.textContent = message;
            else {
              const alert = document.createElement("p");
              alert.className = "error";
              alert.setAttribute("role", "alert");
              alert.textContent = message;
              slide.querySelector(".actions").before(alert);
            }
            if (text) text.focus();
          });
        });
        const submit = document.querySelector("#submit");
        const submitError = document.querySelector("#submit-error");
        const submitStatus = document.querySelector("#submit-status");
        submit.addEventListener("click", () => {
          const chosen = form.querySelector('input[name="visibility"]:checked');
          if (!chosen) {
            submitError.hidden = false;
            submitStatus.hidden = true;
            return;
          }
          submitError.hidden = true;
          submitStatus.hidden = false;
          submitStatus.textContent = "Saved on this device. Not sent yet.";
          submit.disabled = true;
          form.querySelectorAll('input[name="visibility"]').forEach((input) => {
            input.disabled = true;
          });
        });
        window.addEventListener("hashchange", sync);
        sync();
      }
    </script>
  </body>
</html>
