---
import "../../styles/expert.css";
import questions from "../../data/questions.js";

const total = questions.length;
const visibilities = ["anonymous", "public"];

const posted = Astro.request.method === "POST" ? await Astro.request.formData() : null;

const read = (name) => {
  const value = posted?.get(name);
  return typeof value === "string" ? value.trim() : "";
};

const savedAnswer = (question) => {
  const value = read(question.id);
  if (!value) return "";
  if (question.type === "single" && !question.options.some((_, index) => value === `${question.id}-${index}`)) return "";
  return value.slice(0, 4000);
};

const currentRaw = Number(read("current") || "0");
const current = Number.isInteger(currentRaw) && currentRaw >= 0 && currentRaw <= total ? currentRaw : 0;
const stepRaw = posted?.get("step");
let step = stepRaw == null || stepRaw === "" ? current : Number(stepRaw);
if (!Number.isInteger(step) || step < 0 || step > total) step = current;

let error = "";
if (posted && step > current) {
  const question = questions[current];
  if (!savedAnswer(question)) {
    step = current;
    error = question.type === "text" ? "Write an answer to continue." : "Choose an answer to continue.";
  }
}

const visibility = visibilities.includes(read("visibility")) ? read("visibility") : "";
const alreadySubmitted = Astro.cookies.get("submitted")?.value === "1";
let saved = alreadySubmitted;
if (alreadySubmitted) step = total;
if (posted && read("done") === "1" && !alreadySubmitted) {
  step = total;
  if (!visibility) {
    error = "Choose anonymous or public.";
    saved = false;
  } else {
    saved = true;
    Astro.cookies.set("submitted", "1", { path: "/", httpOnly: true, sameSite: "lax", maxAge: 60 * 60 * 24 });
  }
}

const question = questions[step];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Questionnaire</title>
  </head>
  <body>
  {
      <form method="post" action="/questionnaire">
        <input type="hidden" name="current" value={step} />
        {questions.filter((item) => item.id !== question?.id).map((item) => (
          <input type="hidden" name={item.id} value={savedAnswer(item)} />
        ))}
        {step < total ? (
          <>
            <p class="muted">Question {step + 1} of {total}</p>
            {question.type === "single" ? (
              <fieldset>
                <legend>{question.prompt}</legend>
                {question.options.map((option, optionIndex) => {
                  const value = `${question.id}-${optionIndex}`;
                  return (
                    <label class="choice">
                      <input type="radio" name={question.id} value={value} required checked={savedAnswer(question) === value} />
                      {option}
                    </label>
                  );
                })}
              </fieldset>
            ) : (
              <label for={question.id}>{question.prompt}</label>
              <textarea id={question.id} name={question.id} rows="4" required maxlength="4000" placeholder={question.placeholder}>{savedAnswer(question)}</textarea>
            )}
            {error && <p class="notice error" role="alert">{error}</p>}
            <div class="actions">
              <button name="step" value={step + 1}>{step === total - 1 ? "Finish" : "Next"}</button>
              {step > 0 && (
                <button class="secondary" name="step" value={step - 1} formnovalidate>Back</button>
              )}
            </div>
          </>
        ) : (
          <>
            <h1>Thank you for participating</h1>
            <fieldset>
              <legend>Submit as</legend>
              {visibilities.map((option) => (
                <label class="choice">
                  <input type="radio" name="visibility" value={option} required checked={visibility === option} disabled={saved} />
                  {option.slice(0, 1).toUpperCase() + option.slice(1)}
                </label>
              ))}
            </fieldset>
            {error && <p class="notice error" role="alert">{error}</p>}
            <div class="actions">
              {saved ? <button type="button" disabled>Submit</button> : <button name="done" value="1">Submit</button>}
              {!saved && <button class="secondary" name="step" value={total - 1} formnovalidate>Back</button>}
            </div>
          </>
        )}
      </form>
  }
  </body>
</html>
