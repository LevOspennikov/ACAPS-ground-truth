---
import { expertResults } from '../server/expert-results.js';
import { resultsMarkup, majoritySummary } from '../lib/expert-results-view.js';
const { questionId = null, frozen = false, roundTwo = false, refreshHref = '/questionnaire', showRefresh = true, showMajority = false } = Astro.props;
const headingId = `${frozen ? 'round-one' : roundTwo ? 'round-two' : 'group'}-results-title${questionId ? `-${questionId}` : ''}`;
const Heading = questionId ? 'h3' : 'h2';
let result = null;
let failure = '';
try { result = await expertResults(Astro.cookies, { questionId, frozen, roundTwo }); }
catch (error) {
  failure = error.code === 'invalid_results_configuration'
    ? 'Results are withheld because server configuration needs attention. Contact your organiser.'
    : 'Results are unavailable. Refresh this page to retry; contact your organiser if this continues.';
}
const majority = showMajority ? majoritySummary(result?.questions[0]) : null;
---
<section aria-labelledby={headingId}>
  <Heading id={headingId}>{frozen ? 'Round 1 feedback for this question' : roundTwo ? 'Round 2 results for this question' : 'Group results'}</Heading>
  {majority && <p class="majority-summary">{majority}</p>}
  <p>{frozen ? 'Feedback was captured when Round 2 opened and stays the same throughout reassessment.' : roundTwo ? 'These are the updated group answers from submitted Round 2 assessments only.' : 'Answer distributions include final submissions only.'} Written responses stay private.</p>
  {(!result || (!frozen && showRefresh)) && <p role="status">{result ? 'Refresh this page to see the latest results.' : failure || 'Your session ended or access changed. Open a fresh invitation to view results.'}</p>}
  <p class="muted">{frozen ? 'Captured' : 'Last updated'}: <time datetime={result?.updatedAt}>{result ? new Date(result.updatedAt).toUTCString() : 'Not yet available'}</time>{showRefresh && <> · <a href={refreshHref}>Refresh results</a></>}</p>
  <div set:html={result ? resultsMarkup(result.questions, frozen ? { withheldMessage: 'Feedback is withheld because too few answers were available when Round 2 started.' } : {}) : ''} />
</section>
