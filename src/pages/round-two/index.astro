
---
import '../../styles/expert.css';

import { configured } from '../../server/db.js';
import { roundTwoAssignment } from '../../server/auth.js';
import { saveRoundTwoResponse } from '../../server/responses.js';
import { sameOrigin, reject } from '../../server/forms.js';
import {
  validateAnswer,
  firstUnanswered,
  answerLabel
} from '../../server/answers.js';
import ExpertResults from '../../components/ExpertResults.astro';
import ExpertRoundComparison from '../../components/ExpertRoundComparison.astro';

if (Astro.request.method === 'POST' && !sameOrigin(Astro.request)) {
  return reject('Forbidden', 403);
}

let assignment = null;
let loadFailed = false;

try {
  assignment = configured()
    ? await roundTwoAssignment(Astro.cookies)
    : null;
} catch {
  loadFailed = true;
  Astro.response.status = 503;
}

if (!assignment && !loadFailed) {
  Astro.response.status = 401;
}

const questions = assignment?.questions || [];
const originalAnswers = assignment?.round_one_answers || {};
// Retain the original assessment unless the expert explicitly revises it.
const answers = { ...originalAnswers, ...(assignment?.round_two_answers || {}) };

const total = questions.length;

let step = assignment?.round_two_submitted_at
  ? total
  : Math.min(assignment?.round_two_progress_step || 0, total);

let error = '';

if (assignment && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  const current = Number(form.get('current'));
  const intent = form.get('intent');

  if (
    !Number.isInteger(current) ||
    current < 0 ||
    current > total ||
    !['next', 'back', 'save', 'submit'].includes(intent)
  ) {
    return reject('Invalid questionnaire step.');
  }

  if (assignment.round_two_submitted_at) {
    return Astro.redirect('/round-two', 303);
  }

  step = current;

  try {
    if (current < total) {
      answers[questions[current].id] = validateAnswer(
        questions[current],
        form.get('answer') ?? ''
      );
    }

    if (intent === 'next') {
      if (
        questions[current]?.required !== false &&
        !answers[questions[current]?.id]
      ) {
        throw new Error('Answer this question before continuing.');
      }
      step = Math.min(current + 1, total);
    }

    if (intent === 'back') {
      step = Math.max(0, current - 1);
    }

    if (intent === 'submit') {
      const missing = firstUnanswered(questions, answers);

      if (missing < total) {
        step = missing;
        throw new Error('Answer all required questions before submitting.');
      }

      step = total;
    }

    const stored = await saveRoundTwoResponse(
      Astro.cookies,
      assignment.id,
      answers,
      step,
      intent === 'submit'
    );

    if (!stored) {
      const latest = await roundTwoAssignment(Astro.cookies);

      if (latest?.round_two_submitted_at) {
        return Astro.redirect('/round-two', 303);
      }

      return reject('Your session ended or access was revoked.', 401);
    }

    return Astro.redirect(
      intent === 'save'
        ? '/round-two?saved=1'
        : '/round-two',
      303
    );

  } catch (failure) {
    error = [
      'Answer this question before continuing.',
      'Answer all required questions before submitting.',
      'Answers must be under 4,000 characters.',
      'Choose a valid answer.'
    ].includes(failure.message)
      ? failure.message
      : 'Could not save to the server. Please retry.';

    if (error.startsWith('Could not save')) {
      Astro.response.status = 503;
    }
  }
}

const question = questions[step];
const saved = Astro.url.searchParams.has('saved');
const refreshedAt = new Date();
const formatTime = (value) => new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value));
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Round 2 · ACAPS Ground Truth</title>
</head>

<body>
  <main class:list={['expert-shell', { 'submitted-results': assignment?.round_two_submitted_at }]}>

    {!assignment ? (
      <>
        <h1>Round 2 unavailable</h1>
        <p>
          {loadFailed
            ? 'The server could not load your assessment.'
            : 'Round 2 is available after your organiser starts it and you submit Round 1. Return to your questionnaire through your private invitation.'}
        </p>
      </>
    ) : (
      <>
        <p class="muted">ACAPS Ground Truth · Round 2</p>

        <h1>{assignment.title}</h1>

        {!assignment.round_two_submitted_at && <p>
          Review the anonymized group assessment, then reconsider
          your original answers using your own expertise.
        </p>}

        {assignment.round_two_submitted_at ? (
          <><section class="notice submission-confirmation" role="status">
            <p><strong>Round 2 completed.</strong> Your revised answers are saved.</p>
            <a href="/questionnaire">Back to your questionnaire</a>
          </section>
          <div class="results-toolbar"><h2>Your Round 2 results</h2><a href="/round-two">Refresh all results</a></div>
          <p class="results-explainer">Round 1 is frozen; Round 2 updates with submissions. Group sizes may differ. Values show % (count); pp = percentage points. Written responses stay private.</p>
          <p class="results-timestamps">Updated <time datetime={refreshedAt.toISOString()}>{formatTime(refreshedAt)} UTC</time> · Round 1 captured {formatTime(assignment.round_two_started_at)} UTC</p>
          {questions.map((q, index) => <section class="result-card comparison-card" aria-labelledby={`result-${q.id}`}>
            <p class="question-label">Question {index + 1}</p>
            <h2 id={`result-${q.id}`}>{q.prompt}</h2>
            {q.type === 'single' ? <>
              <p class="own-answer-change"><span class="muted">Your answer</span><span>{answerLabel(q, originalAnswers[q.id])}</span><span aria-hidden="true">→</span><span class="sr-only">to</span><strong>{answerLabel(q, answers[q.id])}</strong><small>{originalAnswers[q.id] === answers[q.id] ? 'Unchanged' : 'Revised'}</small></p>
              <ExpertRoundComparison question={q} />
            </> : <div class="written-comparison">
              <div><h3>Your Round 1 answer</h3><p class="answer-context">{answerLabel(q, originalAnswers[q.id])}</p></div>
              <div><h3>Your Round 2 answer</h3><p class="answer-context">{answerLabel(q, answers[q.id])}</p></div>
            </div>}
          </section>)}
          </>
        ) : (
          <>
            <form method="post" action="/round-two">
              <input
                type="hidden"
                name="current"
                value={step}
              />

              {saved && (
                <p class="notice" role="status">
                  Your Round 2 progress was saved on the server.
                </p>
              )}

              {error && (
                <p class="notice error" role="alert">
                  {error}
                </p>
              )}

              {question ? (
                <>
                  <h2>Reassess your answer</h2>
                  <p>Your answer is prefilled. Keep it or revise it using your expertise and any feedback below.</p>

                  <p class="muted">
                    Question {step + 1} of {total}
                  </p>

                  {question.type === 'single' && <ExpertResults questionId={question.id} frozen={true} refreshHref="/round-two" />}

                  <section class="result-card">
                    <h3>Your Round 1 answer</h3>
                    <p>
                      {answerLabel(
                        question,
                        originalAnswers[question.id]
                      )}
                    </p>
                  </section>

                  {question.type === 'single' ? (
                    <fieldset>
                      <legend>{question.prompt}</legend>

                      {question.options.map((option, i) => (
                        <label class="choice">
                          <input
                            type="radio"
                            name="answer"
                            value={`${question.id}-${i}`}
                            checked={
                              answers[question.id] ===
                              `${question.id}-${i}`
                            }
                          />
                          {option}
                        </label>
                      ))}
                    </fieldset>
                  ) : (
                    <>
                      <label for="answer">
                        {question.prompt}{question.required === false ? ' (optional)' : ''}
                      </label>

                      <textarea
                        id="answer"
                        name="answer"
                        rows="4"
                        maxlength="4000"
                        placeholder={question.placeholder}
                      >{answers[question.id] || ''}</textarea>
                    </>
                  )}

                  <div class="actions">
                    {step > 0 && (
                      <button
                        class="secondary"
                        name="intent"
                        value="back"
                      >
                        Back
                      </button>
                    )}

                    <button
                      class="secondary"
                      name="intent"
                      value="save"
                    >
                      Save progress
                    </button>

                    <button name="intent" value="next">
                      {step === total - 1 ? 'Review' : 'Next'}
                    </button>
                  </div>
                </>
              ) : (
                <>
                  <h2>Review your Round 2 answers</h2>

                  {questions.map((q) => (
                    <section class="result-card">
                      <h3>{q.prompt}</h3>
                      <p>{answerLabel(q, answers[q.id])}</p>
                    </section>
                  ))}

                  <p>
                    Submitting will finalize your Round 2 answers.
                  </p>

                  <div class="actions">
                    <button
                      class="secondary"
                      name="intent"
                      value="back"
                    >
                      Back
                    </button>

                    <button
                      name="intent"
                      value="submit"
                    >
                      Submit Round 2
                    </button>
                  </div>
                </>
              )}
            </form>
          </>
        )}
      </>
    )}
  </main>
</body>
</html>
