---
import { expertResults } from '../server/expert-results.js';
import { resultsMarkup } from '../lib/expert-results-view.js';
let result = null;
let failure = '';
try { result = await expertResults(Astro.cookies); }
catch (error) {
  failure = error.code === 'invalid_results_configuration'
    ? 'Results are withheld because server configuration needs attention. Contact your organiser.'
    : 'Results are unavailable. Refresh this page to retry; contact your organiser if this continues.';
}
---
<section aria-labelledby="group-results-title">
  <h2 id="group-results-title">Group results</h2>
  <p>Answer distributions include final submissions only. Written responses stay private.</p>
  <p role="status">{result ? 'Refresh this page to see the latest results.' : failure || 'Your session ended or access changed. Open a fresh invitation to view results.'}</p>
  <p class="muted">Last updated: <time datetime={result?.updatedAt}>{result ? new Date(result.updatedAt).toUTCString() : 'Not yet available'}</time> · <a href="/questionnaire">Refresh results</a></p>
  <div set:html={result ? resultsMarkup(result.questions) : ''} />
</section>
